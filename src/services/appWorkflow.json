{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "3.0.0",
  "name": "Autohaus-OS-Hierarchical-3Layer-Workflow-Specification",
  "description": "Zentrale, deterministische 3-Schichten-Architektur für Autohaus OS und Max AI: 1. Navigation/Hauptbefehle, 2. Prozess-Kontext & Detail-Eingabefelder (mit Validierung & Pflichtwerten), 3. Operative Ausführungsbefehle (Drucken, E-Mail-Versand, PDF/XML/DATEV Export) und Compound Workflows zur Verhinderung von Halluzinationen.",
  
  "systemRules": {
    "strictAntiHallucination": true,
    "disallowedOperations": [
      "Erfinden fiktiver Fahrzeugdaten (Preise, FIN, HSN/TSN, Halter)",
      "Erfinden fiktiver Kundendaten oder Anschriften",
      "Ausführen von Layer-3-Befehlen ohne validierten Layer-2-Kontext",
      "Vorschlagen nicht-existenter Module oder unregistrierter Parameter"
    ],
    "disambiguationRule": "Gibt es bei einer Suche nach Marke, Modell oder Kunde mehrere Treffer in der Datenbank, MUSS eine Auswahlentscheidung erzwungen werden.",
    "validationEngine": {
      "vinRegex": "^[A-HJ-NPR-Z0-9]{17}$",
      "hsnRegex": "^[0-9]{4}$",
      "tsnRegex": "^[A-Z0-9]{3}$",
      "emailRegex": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
      "ibanRegex": "^[A-Z]{2}[0-9]{2}[A-Z0-9]{1,30}$"
    }
  },

