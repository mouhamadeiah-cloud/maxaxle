  "compoundWorkflows": [
    {
      "compoundId": "CW_ADD_VEHICLE_PAYMENT",
      "title": "Zahlung / Anzahlung für Fahrzeug erfassen",
      "keywords": [
        "anzahlung für fahrzeug", "zahlung für auto", "barzahlung auto", "restzahlung für fahrzeug",
        "دفعة للسيارة", "دفعة نقدا للسيارة", "دفعة كاش للسيارة", "سجل دفعة", "سجل انزال دفعة", "اضف دفعة"
      ],
      "description": "Mehrschichtige Operation: Sucht das Fahrzeug in Schicht 1, füllt die Buchungsparameter in Schicht 2 und aktualisiert Kassenbuch & Fahrzeugsaldo in Schicht 3.",
      "steps": [
        {
          "stepOrder": 1,
          "targetLayer": "LAYER_1_NAVIGATION_MACRO",
          "action": "NAVIGATE_AND_SELECT_ENTITY",
          "targetTab": "finanzen",
          "lookupEntity": "vehicles",
          "description": "Fahrzeug identifizieren und Finanzen-Ansicht öffnen"
        },
        {
          "stepOrder": 2,
          "targetLayer": "LAYER_2_ENTITY_FORMS",
          "action": "POPULATE_FORM",
          "targetSection": "FORM_FINANCE_TRANSACTION_ADD",
          "mapping": {
            "type": "EINNAHME",
            "category": "ANZAHLUNG",
            "paymentMethod": "BARKASSE",
            "amount": "{{amount}}",
            "date": "{{date || CURRENT_DATE}}",
            "vehicleId": "{{matchedVehicle.id}}",
            "description": "Anzahlung Bar für {{matchedVehicle.brand}} {{matchedVehicle.model}} (FIN: {{matchedVehicle.vin}})"
          }
        },
        {
          "stepOrder": 3,
          "targetLayer": "LAYER_3_OPERATIONAL_EXECUTION",
          "action": "EXECUTE_OPERATIONS",
          "operations": ["OP_SAVE_FINANCE_ENTRY", "OP_UPDATE_VEHICLE_BALANCE"],
          "description": "Buchung im Kassenbuch festschreiben und Fahrzeugsaldo angleichen"
        }
      ],
      "expectedNextSuggestions": [
        { "label": "Quittung drucken", "opId": "OP_PRINT_DOCUMENT" },
        { "label": "Kassenbuch ansehen", "tabKey": "finanzen" },
        { "label": "Kaufvertrag für dieses Fahrzeug erstellen", "tabKey": "operationen", "docType": "KAUFVERTRAG" }
      ]
    },

    {
      "compoundId": "CW_CREATE_CONTRACT_WITH_CUSTOMER_AND_CAR",
      "title": "Kaufvertrag für Kunde & Fahrzeug erstellen",
      "keywords": [
        "kaufvertrag erstellen für", "auto verkaufen an", "vertrag für fahrzeug an kunde",
        "انشئ عقد بيع للعميل", "بيع سيارة للعميل", "عقد شراء للسيارة"
      ],
      "description": "Mehrschichtige Operation: Öffnet Operationen-Hub (Schicht 1), verknüpft Fahrzeug & Kunde mit Kaufpreis (Schicht 2) und generiert den fertigen Vertragsentwurf (Schicht 3).",
      "steps": [
        {
          "stepOrder": 1,
          "targetLayer": "LAYER_1_NAVIGATION_MACRO",
          "action": "NAVIGATE_TO_VIEW",
          "targetTab": "operationen"
        },
        {
          "stepOrder": 2,
          "targetLayer": "LAYER_2_ENTITY_FORMS",
          "action": "POPULATE_FORM",
          "targetSection": "SEC_DOC_KAUFVERTRAG",
          "mapping": {
            "vehicleId": "{{matchedVehicle.id}}",
            "customerId": "{{matchedCustomer.id}}",
            "sellingPrice": "{{price || matchedVehicle.sellingPrice}}",
            "taxMode": "{{matchedVehicle.vatType === 'Differenzbesteuerung §25a' ? 'DIFF_25A' : 'REGEL_19'}}",
            "invoiceDate": "{{CURRENT_DATE}}"
          }
        },
        {
          "stepOrder": 3,
          "targetLayer": "LAYER_3_OPERATIONAL_EXECUTION",
          "action": "EXECUTE_OPERATIONS",
          "operations": ["OP_RENDER_PDF_PREVIEW"],
          "description": "Vorschau des Kaufvertrags rendern und druckfertig bereitstellen"
        }
      ],
      "expectedNextSuggestions": [
