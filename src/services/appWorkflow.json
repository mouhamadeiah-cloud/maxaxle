          },
          "prerequisites": ["amountProvided", "categoryProvided", "dateProvided", "descriptionProvided"]
        },
        {
          "opId": "OP_UPDATE_VEHICLE_BALANCE",
          "label": "Zahlungsstatus & Restbetrag aktualisieren",
          "keywords": ["restbetrag berechnen", "zahlung verrechnen", "تحديث رصيد السيارة"],
          "executionType": "STATE_RECALCULATE",
          "parameters": {
            "recalculateVehicleRemainingBalance": true
          },
          "prerequisites": ["vehicleIdValid", "amountProvided"]
        },
        {
          "opId": "OP_EXPORT_DATEV_CSV",
          "label": "DATEV / Steuerberater CSV Export",
