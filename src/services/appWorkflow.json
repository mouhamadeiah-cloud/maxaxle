    "LAYER_3_OPERATIONAL_EXECUTION": {
      "layerId": 3,
      "layerName": "Schicht 3: Operative Ausführungsbefehle",
      "description": "Die ausführende Schicht für Dokumentenerzeugung, Druckausgabe, E-Mail-Versand, PDF/XML/DATEV Exporte und dauerhafte Speicherung. Jeder Befehl definiert strukturierte Parameter und Vorbedingungen, um Halluzinationen auszuschließen.",
      "operations": [
        {
          "opId": "OP_RENDER_PDF_PREVIEW",
          "label": "PDF-Vorschau anzeigen",
          "keywords": ["vorschau", "dokument ansehen", "prüfen", "عرض المستند", "معاينة"],
          "executionType": "UI_MODAL_RENDER",
          "parameters": {
            "viewMode": "high-res-canvas",
            "zoom": 100,
            "showWatermark": false
          },
          "prerequisites": ["vehicleSelected", "customerSelected", "documentTypeValid"]
        },
        {
          "opId": "OP_PRINT_DOCUMENT",
          "label": "Dokument drucken (DIN A4)",
          "keywords": ["drucken", "ausdrucken", "print", "طباعة", "اطبع العقد", "اطبع الفاتورة"],
          "executionType": "SYSTEM_PRINT",
          "parameters": {
            "format": "A4",
            "orientation": "portrait",
            "margins": "standard_mm_15",
            "colorMode": "color"
          },
          "prerequisites": ["vehicleSelected", "customerSelected", "documentTypeValid"]
        },
        {
          "opId": "OP_DOWNLOAD_PDF",
          "label": "PDF herunterladen / exportieren",
          "keywords": ["download", "pdf speichern", "herunterladen", "تحميل pdf", "تصدير pdf"],
          "executionType": "FILE_DOWNLOAD_PDF",
          "parameters": {
            "pdfStandard": "PDF/A-3b",
            "compression": "high",
            "embedFonts": true,
            "filenamePattern": "{{docType}}_{{invoiceNumber}}_{{customerName}}.pdf"
          },
          "prerequisites": ["documentGenerated"]
        },
        {
          "opId": "OP_SEND_EMAIL_DOCUMENT",
          "label": "Dokument per E-Mail an Käufer senden",
          "keywords": ["per email senden", "an käufer mailen", "rechnung senden", "ارسال ايميل", "ارسال الفاتورة بالبريد"],
          "executionType": "SERVICE_MAIL_DISPATCH",
          "parameters": {
            "recipientEmail": "{{customer.email}}",
            "subject": "Ihr {{docTitle}} - {{company.name}}",
            "attachPdf": true,
            "mailTemplate": "DOCUMENT_DISPATCH_DEFAULT"
          },
          "prerequisites": ["customerEmailValid", "documentGenerated"]
        },
        {
          "opId": "OP_EXPORT_XML_ERECHNUNG",
          "label": "E-Rechnung XML exportieren (ZUGFeRD / XRechnung)",
          "keywords": ["xml export", "xrechnung download", "zugferd export", "تصدير فاتورة الكترونية"],
          "executionType": "FILE_DOWNLOAD_XML",
          "parameters": {
            "profile": "EN16931_COMFORT",
            "schemaVersion": "2.2",
            "encoding": "UTF-8"
          },
          "prerequisites": ["b2bCustomerSelected", "vatIdProvided", "grossAmountValid"]
        },
        {
          "opId": "OP_SAVE_AND_PERSIST",
          "label": "Dokument & Vorgang dauerhaft speichern",
          "keywords": ["speichern", "vertrag sichern", "abschließen", "حفظ", "تثبيت العقد"],
          "executionType": "DATABASE_PERSIST",
          "parameters": {
            "targetCollection": "invoices",
            "generateAuditRecord": true,
            "recalculateVehicleStatus": true
          },
          "prerequisites": ["invoiceNumberUnique", "grossAmountValid"]
        },
        {
          "opId": "OP_SAVE_VEHICLE",
          "label": "Fahrzeug im Bestand speichern",
          "keywords": ["fahrzeug speichern", "auto anlegen abschließen", "حفظ السيارة"],
          "executionType": "DATABASE_PERSIST_VEHICLE",
          "parameters": {
            "targetCollection": "vehicles",
            "updateKbaData": true
          },
          "prerequisites": ["brandProvided", "modelProvided", "purchasePriceProvided", "sellingPriceProvided"]
        },
        {
          "opId": "OP_SAVE_CUSTOMER",
          "label": "Kunde in Kartei speichern",
          "keywords": ["kunde speichern", "kontakt anlegen", "حفظ العميل"],
          "executionType": "DATABASE_PERSIST_CUSTOMER",
          "parameters": {
            "targetCollection": "customers",
            "validateVatIdOnline": false
          },
          "prerequisites": ["customerNameProvided", "streetProvided", "cityProvided"]
        },
        {
          "opId": "OP_SAVE_FINANCE_ENTRY",
          "label": "Kassenbuch-Eintrag verbuchen",
          "keywords": ["zahlung buchen", "kassenbucheintrag sichern", "تسجيل الحركة المالية"],
          "executionType": "DATABASE_PERSIST_FINANCE",
          "parameters": {
            "targetCollection": "cashbook",
