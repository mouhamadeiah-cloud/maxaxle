      "sections": [
        {
          "sectionId": "SEC_DOC_KAUFVERTRAG",
          "parentView": "VIEW_OPERATIONEN",
          "documentType": "KAUFVERTRAG",
          "title": "Kaufvertrag für Gebrauchtfahrzeuge",
          "keywords": ["kaufvertrag", "auto verkaufen", "vertrag", "عقد بيع", "عقد شراء سيارة"],
          "fields": [
            { "key": "vehicleId", "label": "Fahrzeug auswählen", "type": "string", "required": true, "source": "vehicles", "validation": { "mustExistInDb": true } },
            { "key": "customerId", "label": "Käufer auswählen", "type": "string", "required": true, "source": "customers", "validation": { "mustExistInDb": true } },
            { "key": "invoiceNumber", "label": "Vertrags-/Rechnungsnummer", "type": "string", "required": true, "autoGenerate": true, "validation": { "pattern": "^[A-Z0-9\\-_/]{3,30}$" } },
            { "key": "invoiceDate", "label": "Vertragsdatum", "type": "date", "required": true, "default": "CURRENT_DATE" },
            { "key": "deliveryDate", "label": "Übergabedatum", "type": "date", "required": false },
            { "key": "sellingPrice", "label": "Kaufpreis Brutto (€)", "type": "number", "required": true, "validation": { "min": 1, "max": 2000000 } },
            { "key": "taxMode", "label": "Besteuerungsart", "type": "enum", "enum": ["DIFF_25A", "REGEL_19", "STEUERFREI_EXPORT"], "required": true, "default": "DIFF_25A" },
            { "key": "paymentMethod", "label": "Zahlungsart", "type": "enum", "enum": ["BARKASSE", "UEBERWEISUNG", "EC_KARTE", "FINANZIERUNG"], "required": true, "default": "UEBERWEISUNG" },
            { "key": "depositAmount", "label": "Geleistete Anzahlung (€)", "type": "number", "required": false, "default": 0, "validation": { "min": 0, "max": "{{sellingPrice}}" } },
            { "key": "warrantyClause", "label": "Gewährleistung / Ausschluss", "type": "enum", "enum": ["B2C_12_MONATE", "B2B_AUSSCHLUSS", "KUNDENAUFTRAG_AUSSCHLUSS"], "required": true, "default": "B2C_12_MONATE" },
            { "key": "accidentCondition", "label": "Unfallfreiheit", "type": "enum", "enum": ["UNFALLFREI", "BESCHAEDIGT_REPARIERT", "UNFALLWAGEN"], "required": true, "default": "UNFALLFREI" },
            { "key": "customClauses", "label": "Zusätzliche Vereinbarungen", "type": "string", "required": false }
          ],
          "allowedNextLayers": ["LAYER_3_OPERATIONAL_EXECUTION"],
          "nextLayerActions": ["OP_RENDER_PDF_PREVIEW", "OP_PRINT_DOCUMENT", "OP_DOWNLOAD_PDF", "OP_SEND_EMAIL_DOCUMENT", "OP_SAVE_AND_PERSIST"]
